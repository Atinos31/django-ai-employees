# Copy this file to .env and fill in your own values. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True

# MySQL
DB_NAME=ai_employee_db
DB_USER=root
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306

# Anthropic (Claude)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5

# Stripe (use test mode keys)
STRIPE_SECRET_KEY=your-stripe-test-secret-key
STRIPE_CURRENCY=eur

# Optional
# MANAGER_REFUND_LIMIT=1000          # largest refund the Manager Agent may approve alone (EUR)
# ALLOWED_HOSTS=example.com          # comma-separated, not needed locally
# CSRF_TRUSTED_ORIGINS=https://example.com
# CHROMA_PATH=/path/to/chroma_db     # defaults to ./chroma_db, or the Railway volume
# CURRENCY_SYMBOL=€
# LOG_LEVEL=INFO
